# Copy to .env and uncomment what you need. Every variable the code reads is listed here.

# --- Anthropic: stated-goal research, Likely Priorities, email copy, preflight ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Required by main.py (it refuses to start without all four) ---
# STRING_API_KEY=
# QUICKENRICH_API_KEY=
# APOLLO_API_KEY=
# HUNTER_API_KEY=

# --- Fibery: every read and write ---
# FIBERY_API_TOKEN=

# --- Optional providers ---
# SCRUBBY_API_KEY=        # only used with main.py --scrub
# EXA_API_KEY=            # second search index when web search finds no stated goal
# JINA_API_KEY=           # optional; raises Jina's free-tier rate limit

# --- Tuning (defaults shown) ---
# MAIN_PY_DEADLINE_SEC=1500   # main.py stops starting new companies after this many seconds
# ROTATION_BATCH_SIZE=200     # domains per day in sync_watchlist.py's rotation
